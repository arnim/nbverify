{
  "name": "nbverify",
  "version": "0.1.0",
  "description": "Check that a Binder-ready repository's notebooks actually execute",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nbverify": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/runner.py','dist/runner.py'); require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:fast": "npm run build && node --test test/cli.test.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.5"
  }
}
