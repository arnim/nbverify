{
  "name": "nbverify",
  "version": "0.1.0",
  "description": "Check that a Binder-ready repository's notebooks actually execute",
  "license": "BSD-3-Clause",
  "type": "module",
  "bin": {
    "nbverify": "src/cli.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:fast": "node --test test/cli.test.js test/file-utils.test.js",
    "test:e2e:repo2docker:smoke": "node --test --test-concurrency=1 --test-name-pattern=\"^repo2docker/(python-jupyter|build-failure)$\" test/e2e.test.js",
    "test:e2e:repo2docker": "node --test --test-concurrency=1 --test-name-pattern=\"^repo2docker/\" test/e2e.test.js",
    "test:e2e:binderbot": "node --test --test-concurrency=1 --test-name-pattern=\"^binderbot/\" test/e2e.test.js",
    "test:e2e:jupyter4nfdi": "node --test --test-concurrency=1 --test-name-pattern=\"^jupyter4nfdi/\" test/e2e.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  }
}
