{
  "name": "nbverify",
  "version": "0.1.0",
  "description": "Check that a Binder-ready repository's notebooks actually execute",
  "license": "BSD-3-Clause",
  "type": "module",
  "bin": {
    "nbverify": "src/cli.js"
